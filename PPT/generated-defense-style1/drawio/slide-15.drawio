                <mxCell id="t69" value="• 编译后代码占用受限，过度 JIT 会导致&#xa;• code cache 抖动与淘汰，收益反降" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontColor=#202935;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="1314" y="276" width="260" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="r70" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#ffffff;strokeColor=#9fb6d9;strokeWidth=1;fontFamily=Microsoft YaHei;fontColor=#202935;fontSize=16;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1196" y="367" width="410" height="130" as="geometry"/>
