                <mxCell id="o71" value="◴" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00469b;strokeColor=#00469b;fontFamily=Microsoft YaHei;fontColor=#ffffff;fontSize=28;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
